<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox alignment="CENTER" spacing="15" xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.JogoController">
    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <Label text="Cadastro de Jogos" style="-fx-font-size: 20px; -fx-font-weight: bold;" />
    
    <GridPane alignment="CENTER" hgap="10" vgap="10">
        <Label text="Título do Jogo:" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
        <TextField fx:id="txtTitulo" GridPane.columnIndex="1" GridPane.rowIndex="0" promptText="Ex: Elden Ring"/>
        
        <Label text="Preço (R$):" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
        <TextField fx:id="txtPreco" GridPane.columnIndex="1" GridPane.rowIndex="1" promptText="Ex: 199.90"/>
    </GridPane>

    <HBox alignment="CENTER" spacing="20">
        <Button text="Cadastrar" onAction="#cadastrar" prefWidth="100"/>
        <Button text="Atualizar" onAction="#atualizar" prefWidth="100"/>
    </HBox>

    <Label fx:id="lblMensagem" text="" textAlignment="CENTER" wrapText="true" style="-fx-font-weight: bold;"/>
</VBox>
