<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane prefHeight="600.0" prefWidth="660.0" style="-fx-background-color: #1A1A2E;" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.template.JogoController">
    <children>

        <Label layoutX="20.0" layoutY="20.0" style="-fx-text-fill: #E94560; -fx-font-size: 26px; -fx-font-weight: bold;" text="Biblioteca de Jogos" />

        <Pane layoutX="20.0" layoutY="65.0" prefHeight="130.0" prefWidth="620.0" style="-fx-border-color: #0F3460; -fx-border-radius: 8; -fx-border-width: 2; -fx-background-color: #16213E; -fx-background-radius: 8;">
            <children>
                <Label layoutX="20.0" layoutY="15.0" style="-fx-text-fill: #A6B1E1; -fx-font-weight: bold; -fx-font-size: 14px;" text="Nome do Jogo *:" />
                <Label layoutX="20.0" layoutY="55.0" style="-fx-text-fill: #A6B1E1; -fx-font-weight: bold; -fx-font-size: 14px;" text="Tipo / Gênero *:" />
                <Label layoutX="20.0" layoutY="95.0" style="-fx-text-fill: #A6B1E1; -fx-font-weight: bold; -fx-font-size: 14px;" text="Versão *:" />

                <TextField id="txtNome" fx:id="txtNome" layoutX="140.0" layoutY="10.0" prefWidth="450.0" promptText="Ex: The Witcher 3" style="-fx-background-color: #1A1A2E; -fx-text-fill: white; -fx-prompt-text-fill: #666666; -fx-border-color: #E94560; -fx-border-radius: 5; -fx-background-radius: 5;" />

                <ComboBox fx:id="cbxTipo" layoutX="140.0" layoutY="50.0" prefWidth="450.0" style="-fx-background-color: #1A1A2E; -fx-control-inner-background: #1A1A2E; -fx-text-base-color: white; -fx-border-color: #E94560; -fx-border-radius: 5; -fx-background-radius: 5;" />

                <TextField id="txtVersao" fx:id="txtVersao" layoutX="140.0" layoutY="90.0" prefWidth="450.0" promptText="Ex: 1.04 ou Definitive Edition" style="-fx-background-color: #1A1A2E; -fx-text-fill: white; -fx-prompt-text-fill: #666666; -fx-border-color: #E94560; -fx-border-radius: 5; -fx-background-radius: 5;" />
            </children>
        </Pane>

        <Button fx:id="btnCadastrar" layoutX="20.0" layoutY="210.0" mnemonicParsing="false" onAction="#btnCadastrarAction" prefHeight="35.0" prefWidth="145.0" style="-fx-background-color: #0F3460; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 13px; -fx-background-radius: 8; -fx-cursor: hand;" text="➕ CADASTRAR" />
        <Button fx:id="btnAlterar" disable="true" layoutX="178.0" layoutY="210.0" mnemonicParsing="false" onAction="#btnAlterarAction" prefHeight="35.0" prefWidth="145.0" style="-fx-background-color: #A6B1E1; -fx-text-fill: #1A1A2E; -fx-font-weight: bold; -fx-font-size: 13px; -fx-background-radius: 8; -fx-cursor: hand;" text="✏️ ALTERAR" />
        <Button fx:id="btnExcluir" disable="true" layoutX="336.0" layoutY="210.0" mnemonicParsing="false" onAction="#btnExcluirAction" prefHeight="35.0" prefWidth="145.0" style="-fx-background-color: transparent; -fx-border-color: #E94560; -fx-text-fill: #E94560; -fx-font-weight: bold; -fx-font-size: 13px; -fx-border-radius: 8; -fx-background-radius: 8; -fx-cursor: hand;" text="🗑️ EXCLUIR" />
        <Button fx:id="btnLimpar" layoutX="494.0" layoutY="210.0" mnemonicParsing="false" onAction="#btnLimparAction" prefHeight="35.0" prefWidth="145.0" style="-fx-background-color: transparent; -fx-border-color: #A6B1E1; -fx-text-fill: #A6B1E1; -fx-font-weight: bold; -fx-font-size: 13px; -fx-border-radius: 8; -fx-background-radius: 8; -fx-cursor: hand;" text="🧹 LIMPAR" />

        <Label fx:id="lblMensagem" layoutX="20.0" layoutY="255.0" prefWidth="620.0" style="-fx-font-weight: bold; -fx-font-size: 13px;" text="" />

        <TableView fx:id="tblJogo" layoutX="20.0" layoutY="285.0" onMouseClicked="#carregarCampos" prefHeight="295.0" prefWidth="620.0" style="-fx-base: #16213E; -fx-control-inner-background: #16213E; -fx-background-color: #16213E; -fx-table-cell-border-color: #0F3460; -fx-selection-bar: #E94560; -fx-selection-bar-non-focused: #E94560;">
            <columns>
                <TableColumn fx:id="colNome" prefWidth="280.0" style="-fx-text-fill: white;" text="Nome do Jogo" />
                <TableColumn fx:id="colTipo" prefWidth="170.0" style="-fx-text-fill: white;" text="Tipo / Gênero" />
                <TableColumn fx:id="colVersao" prefWidth="168.0" style="-fx-text-fill: white;" text="Versão" />
            </columns>
        </TableView>

    </children>
</AnchorPane>